{
  "version": 2,
  "functions": {
    "src/server.ts": {
      "runtime": "nodejs24.x"
    }
  },
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "src/server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "\\/(.*)", "dest": "/src/server.ts" }
  ]
}
